APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://novape.pe

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=novape
DB_USERNAME=novape_runtime
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@novape.pe"
MAIL_FROM_NAME=""

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME=""

# AI Asistentes
PANEL_ASSISTANT_GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
CHATBOT_MODEL=gemini-2.5-flash

# API PERU (Facturación Electrónica SUNAT)
API_PERU_URL=https://apiperu.dev/api
API_PERU_TOKEN=

# NIUBIZ (Pasarela de Pagos)
NIUBIZ_USER=
NIUBIZ_PASSWORD=
NIUBIZ_MERCHANT_ID=
NIUBIZ_ENV=sandbox

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=

# Separate backup identity; execution account must not have DDL privileges
DB_BACKUP_CONNECTION=mysql_backup
DB_BACKUP_USERNAME=novape_backup
DB_BACKUP_PASSWORD=
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_OFFSITE_DISK=
DB_BACKUP_SECONDARY_DISK=
DB_BACKUP_SECONDARY_PATH=
DB_MAINTENANCE_FILE=mariadb-maintenance.enc
INVOICE_ENVIRONMENT=sandbox
REPORT_INCLUDE_DEMO=false

# Private employee chat and integrated WebRTC calls (max. 6 live participants)
TEAM_CALL_MAX_PARTICIPANTS=6
TEAM_STUN_URL=stun:stun.l.google.com:19302
TEAM_TURN_URL=
TEAM_TURN_SECRET=
# Use static TURN credentials only when the relay does not support shared secrets.
TEAM_TURN_USERNAME=
TEAM_TURN_PASSWORD=
