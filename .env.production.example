APP_NAME="Novape eCommerce"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://novape.me

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Azure Database for MySQL Flexible Server
DB_CONNECTION=mysql
DB_HOST=novape-mysql.mysql.database.azure.com
DB_PORT=3306
DB_DATABASE=novape_db
DB_USERNAME=novapeadmin
DB_PASSWORD=TuPasswordSeguro123!
# En Azure MySQL se requiere SSL activado:
MYSQL_ATTR_SSL_CA=

# Stateless Session & Cache (Base de Datos)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Azure Blob Storage (Para imágenes y archivos en la nube)
FILESYSTEM_DISK=azure
AZURE_STORAGE_NAME=novapestorage
AZURE_STORAGE_KEY=tu_azure_storage_access_key
AZURE_STORAGE_CONTAINER=novape-uploads
AZURE_STORAGE_URL=https://novapestorage.blob.core.windows.net/novape-uploads
AZURE_STORAGE_IS_PUBLIC=true

# Ejecución automática de migraciones al arrancar el contenedor
RUN_MIGRATIONS=true
